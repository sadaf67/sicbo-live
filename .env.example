# کپی این فایل به نام .env و مقادیر واقعی را قرار دهید. هرگز فایل .env واقعی را کامیت نکنید.

# باید دقیقاً برابر با SICBO_API_INTERNAL_KEY مربوط به sicbo در /opt/telegram-bot/.env روی VPS
# باشد تا ربات تلگرام مشترک بتواند حساب بازیکنان خریداری‌شده را در این بازی فعال کند.
INTERNAL_API_KEY=

# کلید امضای JWT - حداقل ۳۲ کاراکتر تصادفی. هرگز مقدار پیش‌فرض appsettings.json را در پروداکشن استفاده نکنید.
JWT_KEY=

# باید دقیقاً با کلید/رمز پیکربندی‌شده در deploy/livekit/livekit.yaml یکی باشد.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
